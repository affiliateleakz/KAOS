{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaos",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CANDLE_ARCHIVE",
      "bucket_name": "kaos-candle-archive"
    }
  ],
  "vars": {
    "ALPACA_FEED": "iex",
    "OANDA_ENVIRONMENT": "practice",
    "MARKETS_JSON": "[{\"symbol\":\"AAPL\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"NVDA\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"MSFT\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"AMZN\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"GOOGL\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"META\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"TSLA\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"AMD\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"PLTR\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"COIN\",\"asset_class\":\"stock\",\"seconds\":60},{\"symbol\":\"SPY\",\"asset_class\":\"etf\",\"seconds\":60},{\"symbol\":\"QQQ\",\"asset_class\":\"etf\",\"seconds\":60},{\"symbol\":\"BTC-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"ETH-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"SOL-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"XRP-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"DOGE-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"ADA-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"LINK-USD\",\"asset_class\":\"crypto\",\"seconds\":60},{\"symbol\":\"AVAX-USD\",\"asset_class\":\"crypto\",\"seconds\":60}]"
  }
}
