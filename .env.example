# Local development only. Copy to .env (git-ignored). Never put real secrets here.
KAOS_ENV=development
MONGO_URL=mongodb://mongo:27017
DB_NAME=kaos_dev
JWT_SECRET=dev-only-change-me
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=dev-owner-password
KAOS_DEMO_PASSWORD=dev-demo-password
# Optional - leave blank to keep integrations disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
EMERGENT_EMAIL_KEY=
KAOS_COINBASE_LIVE_ORDERS=false
KAOS_BROKER_VAULT_KEY=
KAOS_COLLECTOR_KEY=
# Market Intelligence Center (optional). Stock scanner stays "provider_not_configured" without these.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
KAOS_ALPACA_FEED=iex
# Options research only lists rows already collected by the options collector.
TRADIER_TOKEN=
