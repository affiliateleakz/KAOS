# Local development only. Copy to .env (git-ignored). Never put real secrets here.
KAOS_ENV=development
MONGO_URL=mongodb://mongo:27017
DB_NAME=kaos_dev
JWT_SECRET=dev-only-change-me
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=dev-owner-password
KAOS_DEMO_PASSWORD=dev-demo-password

# --- Billing (Stripe) ---
# Checkout, webhooks and subscription lifecycle. Without these, /api/billing returns "not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (password reset / verification) ---
# Defaults to the Emergent integration proxy. Point INTEGRATION_PROXY_URL at a KAOS-owned provider to drop the third party.
INTEGRATION_PROXY_URL=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=KAOS Trading

# --- AI (OpenAI) ---
# /api/ai/brain and the AI insights path. Unset = AI insights return a configuration error.
OPENAI_API_KEY=
KAOS_FINBERT_ENABLED=false
KAOS_FINBERT_MODEL_PATH=

# --- Market data: stocks (Alpaca) ---
# Required by /api/stocks/heatmap and the alpaca_stocks collector.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
KAOS_ALPACA_STOCK_FEED=iex

# --- Market data: options (Tradier) ---
# Required by the options-activity collector.
TRADIER_TOKEN=
KAOS_OPTIONS_ACTIVITY_STATE=

# --- Market data: FX (OANDA) ---
OANDA_API_TOKEN=
OANDA_ENV=practice

# --- Market data: on-chain (Ethereum JSON-RPC) ---
# Must be HTTPS. Required by the ethereum_whales collector.
ETH_RPC_URL=

# --- Regulatory filings (SEC EDGAR) ---
# SEC requires an identifiable User-Agent: "AppName contact@example.com".
KAOS_SEC_USER_AGENT=

# --- Collector -> API ---
# HTTPS base URL the collector services post results to. Loopback is allowed only for development.
KAOS_API_BASE=
KAOS_COLLECTOR_KEY=

# --- Broker vault (Coinbase keys encrypted at rest) ---
# 32-byte urlsafe-base64 Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KAOS_BROKER_VAULT_KEY=
KAOS_BROKER_VAULT_PREVIOUS_KEYS=

# --- Coinbase live orders (keep OFF) ---
# A server-side kill switch and approval gate are still required before any live use.
KAOS_COINBASE_LIVE_ORDERS=false
KAOS_COINBASE_MAX_ORDER_USD=
KAOS_COINBASE_POSITION_MONITOR=false
KAOS_COINBASE_RECOVERY_WORKER=false
KAOS_COINBASE_RECOVERY_INTERVAL_SEC=

# --- Candle research worker ---
KAOS_ENABLE_CANDLE_WORKER=false
KAOS_CANDLE_OWNER_USER_ID=

# --- Paper trading journal ---
KAOS_PAPER_JOURNAL_PATH=

# --- Research only (never in production) ---
# PO_SSID must be a DEMO Pocket Option session. Never share or commit it.
PO_SSID=

# --- Dev-only test credential dump ---
# Written only when KAOS_ENV=development and this path is set explicitly.
KAOS_TEST_CREDENTIALS_PATH=
