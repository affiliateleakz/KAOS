# Private supervisor file: /etc/kaos/coinbase.env, root-owned mode 0600.
# Replace placeholders with the SAME database and broker vault configuration as
# the KAOS API. Never generate a new vault key here or commit real values.
MONGO_URL=REPLACE_WITH_EXISTING_API_DATABASE_CONNECTION
DB_NAME=REPLACE_WITH_EXISTING_API_DATABASE_NAME
KAOS_BROKER_VAULT_KEY=REPLACE_WITH_EXISTING_API_BROKER_VAULT_KEY
# Preserve previous decrypt keys if the API currently uses rotation keys.
# KAOS_BROKER_VAULT_PREVIOUS_KEYS=
KAOS_COINBASE_CONTROL_ORIGIN=https://api.tradingwithkaos.com
KAOS_COINBASE_LIVE_ORDERS=enabled
KAOS_COINBASE_AUTO_WORKER=enabled
# Optional operator ceiling. Start rejects larger amounts; never silently resizes.
# KAOS_COINBASE_MAX_ORDER_USD=100
# Member Coinbase CDP credentials are read from the encrypted database.
# No Stripe, SMTP, AI training flags or per-member keys belong in this file.
