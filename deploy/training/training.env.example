# Copy privately to the selected worker host; never commit actual credentials.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kaos
JWT_SECRET=replace-with-the-existing-server-secret
FRONTEND_URL=https://tradingwithkaos.com
KAOS_TRAINING_WORKER_ENABLED=true
KAOS_TRAINING_INTERVAL_SECONDS=300
# Use the same provider settings/vault as the API for configured evidence sources.
# No OpenAI key is required by this worker.
