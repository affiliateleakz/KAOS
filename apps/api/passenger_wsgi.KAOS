"""KAOS FastAPI app under cPanel Passenger.

This file is placed beside server.py and deployed kaos-core package.
"""
import os
import sys

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CORE_DIR = os.path.join(BASE_DIR, "packages", "kaos-core")
for directory in (BASE_DIR, CORE_DIR):
    if directory not in sys.path:
        sys.path.insert(0, directory)

from a2wsgi import ASGIMiddleware
from server import app

application = ASGIMiddleware(app)
