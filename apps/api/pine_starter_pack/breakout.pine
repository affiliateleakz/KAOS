// Research template: no profitability guarantee. Validate in TradingView Strategy Tester.
// Python rule backtest is NOT an executed TradingView/Pine backtest.
strategy("KAOS Strategy — Breakout Sentinel", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.4, slippage=2, process_orders_on_close=false, calc_on_order_fills=false, calc_on_every_tick=false)
// Commission defaults assume 0.4% EACH SIDE for crypto. Change Properties for your broker.
// Pine slippage is in ticks; Python research uses 2 basis points. They are not identical.
fastLen = input.int(20, "Fast EMA", minval=2, group="Signals")
slowLen = input.int(50, "Slow EMA", minval=3, group="Signals")
regimeLen = input.int(200, "Regime EMA", minval=20, group="Signals")
atrLen = input.int(14, "ATR length", minval=2, group="Risk")
stopAtr = input.float(2.0, "Stop · ATR", minval=0.1, step=0.1, group="Risk")
targetAtr = input.float(4.0, "Target · ATR", minval=0.1, step=0.1, group="Risk")
startAt = input.time(timestamp("01 Jan 2025 00:00 +0000"), "Allow entries from", group="Window")
endAt = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Allow entries until", group="Window")
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
regime = ta.ema(close, regimeLen)
atr = ta.atr(atrLen)
rsi = ta.rsi(close, 14)
basis = ta.sma(close, 20)
dev = 2.0 * ta.stdev(close, 20)
upper = basis + dev
lower = basis - dev
channelHigh = ta.highest(high[1], 20)
channelLow = ta.lowest(low[1], 10)
ready = bar_index >= math.max(regimeLen, 50) and not na(atr)
entrySignal = barstate.isconfirmed and ready and time >= startAt and time < endAt and (close > regime and close > channelHigh)
exitSignal = barstate.isconfirmed and (close < channelLow)
var float fixedStop = na
var float fixedTarget = na
if strategy.position_size == 0 and strategy.position_size[1] > 0
    fixedStop := na
    fixedTarget := na
if entrySignal and strategy.position_size == 0
    fixedStop := math.max(1, math.round(atr * stopAtr / syminfo.mintick)) * syminfo.mintick
    fixedTarget := math.max(1, math.round(atr * targetAtr / syminfo.mintick)) * syminfo.mintick
    strategy.entry("KAOS", strategy.long, alert_message="KAOS breakout: entry filled")
    strategy.exit("Protection", "KAOS", loss=fixedStop / syminfo.mintick, profit=fixedTarget / syminfo.mintick, alert_message="KAOS breakout: bracket exit filled")
if strategy.position_size > 0 and (exitSignal or time >= endAt)
    strategy.close("KAOS", alert_message="KAOS breakout: signal/window exit filled")
pFast = plot(fast, "EMA 20", color=color.rgb(232,196,111), linewidth=2)
pSlow = plot(slow, "EMA 50", color=color.rgb(67,180,171))
plot(regime, "Regime EMA", color=color.new(color.gray, 30), linewidth=2)
fill(pFast, pSlow, color=fast > slow ? color.new(color.teal, 90) : color.new(color.red, 92), title="Trend ribbon")
plot(channelHigh, "Signal band", color=color.new(color.rgb(232,196,111), 40))
plot(strategy.position_size > 0 ? strategy.position_avg_price - fixedStop : na, "Active stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 ? strategy.position_avg_price + fixedTarget : na, "Active target", color=color.lime, style=plot.style_linebr)
plotshape(entrySignal and strategy.position_size == 0, "Entry setup", shape.triangleup, location.belowbar, color=color.rgb(232,196,111), size=size.tiny, text="KAOS")
bgcolor(ready and close > regime ? color.new(color.teal, 96) : na)
if entrySignal and strategy.position_size == 0
    alert("KAOS breakout confirmed entry setup: " + syminfo.ticker + " · " + timeframe.period, alert.freq_once_per_bar_close)
var table panel = table.new(position.top_right, 2, 4, bgcolor=color.rgb(15,16,18), border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "KAOS · BREAKOUT", text_color=color.rgb(232,196,111))
    table.cell(panel, 1, 0, "LONG ONLY", text_color=color.white)
    table.cell(panel, 0, 1, "Regime", text_color=color.gray)
    table.cell(panel, 1, 1, close > regime ? "ABOVE EMA" : "BELOW EMA", text_color=color.white)
    table.cell(panel, 0, 2, "Closed trades", text_color=color.gray)
    table.cell(panel, 1, 2, str.tostring(strategy.closedtrades), text_color=color.white)
    table.cell(panel, 0, 3, "Status", text_color=color.gray)
    table.cell(panel, 1, 3, strategy.position_size > 0 ? "POSITION OPEN" : "SCANNING", text_color=color.white)
